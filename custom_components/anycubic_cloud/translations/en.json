      "auth_mode_pick": {
        "title": "Authentication Mode",
        "description": "Which authentication mode would you like to use?",
        "menu_options": {
          "auth_mode_web": "Web (No MQTT)",
          "auth_mode_slicer": "Slicer Next (Win)",
