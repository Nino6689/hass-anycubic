      "reauth_or_choose_printer": {
        "title": "Re-Auth or Printer Select",
        "description": "Are you re-authenticating or changing your monitored printer(s)?",
        "menu_options": {
          "reauth": "Re-Authenticate",
          "printer": "Change Printer(s)",
          "connection": "Connection (cloud or local)"
        }
      },
      "user": {
        "title": "Connect your Anycubic account",
        "description": "Home Assistant can't sign in to Anycubic for you — their login uses a captcha and 2-factor check. Instead, paste a **token**: a \"you're already signed in\" pass.\n\n**The easy way — no terminal needed.** The integration's tools folder ({tools_url}) has one-click helpers:\n• **Browser bookmark** — click it on the Anycubic site, token copied. No terminal at all.\n• **Mac** — double-click a file.  • **Windows** — right-click → Run.\n\nEach one only *reads* a value your computer already saved and copies it. They never connect to the internet, ask for your password, or change anything.\n\nThen just paste it below — don't worry about tidying it up, and you don't need to know which type it is. Extra quotes, spaces or even the whole config file are fine, and the right mode is detected for you.",
        "data": {
          "user_token": "Paste your token here",
          "user_device_id": "Device ID (only for the Android method — leave blank otherwise)"
        },
        "data_description": {
          "user_token": "A slicer token gives live, second-by-second updates and the control buttons. A web token gives status only. Whichever you paste, it's detected automatically.",
          "user_device_id": "Leave this empty unless you extracted a token from the Android app's network traffic."
        }
      },
      "connection": {
        "title": "Connection",
        "description": "Choose how Home Assistant reaches the printer.\n\n⚠ Switching LAN Mode on REMOVES the printer from your Anycubic account. Switching it back off does not restore it, and nor does a power cycle — the printer has to be added again in the Anycubic app. This is the printer's behaviour, not the integration's.\n\nChange it at the printer first, then match it here. Your entity IDs stay the same either way.",
        "data": {
          "lan_mode_enabled": "Use the local connection (LAN Mode)",
          "lan_host": "Printer address on your network"
        },
        "data_description": {
          "lan_host": "For example 10.0.0.42. Only needed for the local connection."
        }
      }
    }
  },
