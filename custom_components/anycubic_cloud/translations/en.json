      "local": {
        "title": "Local connection (LAN Mode)",
        "description": "Talk to the printer directly on your network instead of through Anycubic's cloud.\n\n⚠ Switching LAN Mode on REMOVES the printer from your Anycubic account. Switching it back off does not restore it, and nor does a power cycle — the printer has to be added again in the Anycubic app. This is the printer's behaviour, not the integration's.\n\nCloud-only features (the file library, uploads, print history) stop working. Everything the printer itself knows, including filament tracking, keeps working.\n\nSwitch LAN Mode on at the printer first, then enable it here.",
        "data": {
          "lan_mode_enabled": "Use the local connection",
          "lan_host": "Printer address on your network"
        },
        "data_description": {
          "lan_host": "For example 10.0.0.42. A fixed address is strongly recommended."
        }
      }
